# Development-only local PostgreSQL connection. Replace credentials locally.
# scripts/db rejects non-loopback hosts and database names other than uk_exim_erp_dev.
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/uk_exim_erp_dev"

# Separate synthetic CRUD test database. scripts/db/smoke-test.mjs only accepts
# a loopback URL whose database name is exactly uk_exim_erp_test.
TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/uk_exim_erp_test"

# Generate a unique secret locally; never commit the actual value.
BETTER_AUTH_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
BETTER_AUTH_URL="http://localhost:3000"
